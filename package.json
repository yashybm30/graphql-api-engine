{
  "name": "graphql-api-engine",
  "version": "0.1.0",
  "private": true,
  "description": "graphql api engine",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "pretest": "npm run build",
    "pretest:integration": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "dependencies": {
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "express": "^5.1.0",
    "zod": "^4.6.7",
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "graphql": "^16.11.0",
    "mongoose": "^8.19.0",
    "dataloader": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "express-session": "^1.18.2",
    "connect-redis": "^9.0.0",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/express-session": "^1.18.2"
  },
  "overrides": {
    "multer": "^2.4.1",
    "js-yaml": "^5.4.1"
  }
}
